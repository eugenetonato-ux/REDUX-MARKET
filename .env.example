# ==============================================================================
# CONFIGURATION GÉNÉRALE DU SITE
# ==============================================================================
DEBUG=True
SECRET_KEY=redux-insecure-dev-key-change-in-production-2026
ALLOWED_HOSTS=127.0.0.1,localhost
PLATFORM_NAME=REDUX
DEFAULT_COUNTRY_CODE=BJ
DEFAULT_LANGUAGE=fr

# Administration (URL secrète non devinable)
ADMIN_URL_PATH=cpanel-redux

# ==============================================================================
# BASE DE DONNÉES (SUPABASE POSTGRESQL)
# ==============================================================================
# 👉 COLLEZ DIRECTEMENT VOTRE URL SUPABASE ICI :
# (Disponible sur Supabase dans : Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Moteur de secours local (utilisé UNIQUEMENT si DATABASE_URL ci-dessus est vide) :
DB_ENGINE=sqlite

# Configuration MySQL alternative (si non-Supabase)
MYSQL_DATABASE=redux
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ==============================================================================
# SERVICES AUXILIAIRES
# ==============================================================================
# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Paiement (mock, fedapay, kkiapay, etc.)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Emailing
DEFAULT_FROM_EMAIL=noreply@redux.app
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Sécurité & Monitoring Production
CSRF_TRUSTED_ORIGINS=
SENTRY_DSN=

# ==============================================================================
# STOCKAGE MÉDIAS SUPABASE (SUPABASE CLOUD STORAGE S3)
# ==============================================================================
# Passer à True pour stocker les images produits, bannières & KYC sur Supabase Cloud
USE_SUPABASE_STORAGE=False
SUPABASE_PROJECT_REF=wztfqyeegftiazuxbgod
SUPABASE_URL=https://wztfqyeegftiazuxbgod.supabase.co
SUPABASE_STORAGE_BUCKET=redux-media
# Clés d'accès S3 créées sur Supabase dans : Project Settings > Storage > S3 Access Keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-central-1
